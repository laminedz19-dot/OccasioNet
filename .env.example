# SUPABASE_URL: عنوان مشروع Supabase (مثال: https://your-project-ref.supabase.co)
# استبدل القيمة الافتراضية أدناه بعنوان مشروعك الحقيقي عبر لوحة Secrets في AI Studio أو ملف .env محلياً.
SUPABASE_URL=UNCONFIGURED_SUPABASE_URL
URL=UNCONFIGURED_SUPABASE_URL

# SUPABASE_ANON_KEY: المفتاح العام للعميل (anon / publishable public key) مع تفعيل RLS.
# تحذير أمني: لا تضع مفتاح service_role في تطبيقات Android مطلقاً.
SUPABASE_ANON_KEY=UNCONFIGURED_SUPABASE_ANON_KEY
ANON_KEY=UNCONFIGURED_SUPABASE_ANON_KEY

# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY
